+		DBG1(DBG_CFG, "incomplete IKEv1 configuration (server, user name, "
+			 "password and pre-shared key are required)");
+		charonservice->update_status(charonservice,
+									 CHARONSERVICE_GENERIC_ERROR);
+		return JOB_REQUEUE_NONE;
+	}
+	peer.dpd = this->settings->get_int(this->settings, "connection.dpd", 30);
+	peer.rekey_time = this->settings->get_int(this->settings,
+											  "connection.ike_rekey", 10710);
+	peer.jitter_time = peer.rekey_time / 10;
+	peer.over_time = 100;
+	child_rekey = this->settings->get_int(this->settings,
+										  "connection.child_rekey", 3600);
+	child.lifetime.time.rekey = child_rekey;
+	child.lifetime.time.life = child_rekey + child_rekey / 10;
+	child.lifetime.time.jitter = child_rekey / 20;
+
+	this->creds->add_username_password(this->creds, username, password);
+	this->creds->add_psk(this->creds, psk);
+
+	ike_cfg = ike_cfg_create(&ike);
+	proposal = parse_proposal(this, PROTO_IKE, "connection.ike_proposal");
+	if (proposal)
+	{
+		ike_cfg->add_proposal(ike_cfg, proposal);
+	}
+	else
+	{
+		ike_cfg->add_proposal(ike_cfg, proposal_create_from_string(PROTO_IKE,
+										"aes256-sha256-modp2048"));
+	}
+
+	peer_cfg = peer_cfg_create("android", ike_cfg, &peer);
+	/* Mode Config: ask for an IPv4 address (DNS servers are requested by the
+	 * attribute handler) */
+	peer_cfg->add_virtual_ip(peer_cfg, host_create_any(AF_INET));
+
+	/* local authentication, round 1: pre-shared key.  We don't set a local
+	 * identity, so our IP address is used as it is by other IKEv1 clients */
+	auth = auth_cfg_create();
+	auth->add(auth, AUTH_RULE_AUTH_CLASS, AUTH_CLASS_PSK);
+	peer_cfg->add_auth_cfg(peer_cfg, auth, TRUE);
+
+	/* local authentication, round 2: XAuth with user name and password */
+	auth = auth_cfg_create();
+	auth->add(auth, AUTH_RULE_AUTH_CLASS, AUTH_CLASS_XAUTH);
+	auth->add(auth, AUTH_RULE_XAUTH_IDENTITY,
+			  identification_create_from_string(username));
+	peer_cfg->add_auth_cfg(peer_cfg, auth, TRUE);
+
+	/* remote authentication: pre-shared key, gateway identified by its address */
+	auth = auth_cfg_create();
+	remote_id = this->settings->get_str(this->settings, "connection.remote_id",
+										NULL);
+	gateway = remote_id ? identification_create_from_string(remote_id) : NULL;
+	if (!gateway || gateway->get_type(gateway) == ID_ANY)
+	{
+		DESTROY_IF(gateway);
+		gateway = identification_create_from_string(ike.remote);
+		auth->add(auth, AUTH_RULE_IDENTITY_LOOSE, TRUE);
+	}
+	auth->add(auth, AUTH_RULE_IDENTITY, gateway);
+	auth->add(auth, AUTH_RULE_AUTH_CLASS, AUTH_CLASS_PSK);
+	peer_cfg->add_auth_cfg(peer_cfg, auth, FALSE);
+
+	/* one CHILD_SA per remote subnet, local side is our virtual IP */
+	children = linked_list_create();
+	routes = this->settings->get_str(this->settings, "connection.routes", NULL);
+	if (!routes || !strlen(routes))
+	{
+		routes = "0.0.0.0/0";
+	}
+	enumerator = enumerator_create_token(routes, " ,", " ");
+	while (enumerator->enumerate(enumerator, &token))
+	{
+		ts = traffic_selector_create_from_cidr(token, 0, 0, 65535);
+		if (!ts)
+		{
+			DBG1(DBG_CFG, "ignoring invalid subnet '%s'", token);
+			continue;
+		}
+		snprintf(name, sizeof(name), "tunnel-%d", ++index);
+		child_cfg = child_cfg_create(name, &child);
+		proposal = parse_proposal(this, PROTO_ESP, "connection.esp_proposal");
+		if (proposal)
+		{
+			child_cfg->add_proposal(child_cfg, proposal);
+		}
+		else
+		{
+			child_cfg->add_proposal(child_cfg, proposal_create_from_string(
+									PROTO_ESP, "aes256-sha512-modp2048"));
+		}
+		child_cfg->add_traffic_selector(child_cfg, TRUE,
+										traffic_selector_create_dynamic(0, 0, 65535));
+		child_cfg->add_traffic_selector(child_cfg, FALSE, ts);
+		/* keep a reference for ourselves, add_child_cfg() consumes one */
+		child_cfg->get_ref(child_cfg);
+		children->insert_last(children, child_cfg);
+		peer_cfg->add_child_cfg(peer_cfg, child_cfg);
+	}
+	enumerator->destroy(enumerator);
+
+	/* get us an IKE_SA */
+	ike_sa = charon->ike_sa_manager->checkout_by_config(charon->ike_sa_manager,
+														peer_cfg);
+	peer_cfg->destroy(peer_cfg);
+	if (!ike_sa || !children->get_count(children))
+	{
+		if (ike_sa)
+		{
+			charon->ike_sa_manager->checkin_and_destroy(
+										charon->ike_sa_manager, ike_sa);
+		}
+		children->destroy_offset(children, offsetof(child_cfg_t, destroy));
+		charonservice->update_status(charonservice,
+									 CHARONSERVICE_GENERIC_ERROR);
+		return JOB_REQUEUE_NONE;
+	}
+
+	/* store the IKE_SA so we can track its progress */
+	this->ike_sa = ike_sa;
+
+	/* The first initiate() starts Main Mode, XAuth and Mode Config; the others
+	 * queue further Quick Modes that run once the IKE_SA is established. Every
+	 * call consumes one reference of the child config. */
+	enumerator = children->create_enumerator(children);
+	while (enumerator->enumerate(enumerator, &child_cfg))
+	{
+		child_cfg->get_ref(child_cfg);
+		if (ike_sa->initiate(ike_sa, child_cfg, NULL) != SUCCESS)
+		{
+			DBG1(DBG_CFG, "failed to initiate tunnel");
+			failed = TRUE;
+			break;
+		}
+	}
+	enumerator->destroy(enumerator);
+	children->destroy_offset(children, offsetof(child_cfg_t, destroy));
+
+	if (failed)
+	{
+		charon->ike_sa_manager->checkin_and_destroy(charon->ike_sa_manager,
+													ike_sa);
+		return JOB_REQUEUE_NONE;
+	}
+	charon->ike_sa_manager->checkin(charon->ike_sa_manager, ike_sa);
+	return JOB_REQUEUE_NONE;
+}
