+/**
+ * Add the subnets listed in the configuration (separated by spaces or commas)
+ * as routes to the TUN device builder
+ */
+static bool add_configured_routes(vpnservice_builder_t *builder, char *routes)
+{
+	enumerator_t *enumerator;
+	traffic_selector_t *ts;
+	host_t *net;
+	uint8_t prefix;
+	char *token;
+	bool success = TRUE;
+
+	enumerator = enumerator_create_token(routes, " ,", " ");
+	while (success && enumerator->enumerate(enumerator, &token))
+	{
+		ts = traffic_selector_create_from_cidr(token, 0, 0, 65535);
+		if (!ts)
+		{
+			DBG1(DBG_CFG, "ignoring invalid route '%s'", token);
+			continue;
+		}
+		ts->to_subnet(ts, &net, &prefix);
+		success = add_route(builder, net, prefix);
+		net->destroy(net);
+		ts->destroy(ts);
+	}
+	enumerator->destroy(enumerator);
+	return success;
+}
+
+/**
+ * Add routes to the builder: the explicitly configured ones if there are any,
+ * otherwise those derived from the installed IPsec policies of the CHILD_SA
+ */
+static bool add_all_routes(private_android_service_t *this,
+						   vpnservice_builder_t *builder, child_sa_t *child_sa)
+{
+	char *routes;
+
+	routes = this->settings->get_str(this->settings, "connection.routes", NULL);
+	if (routes && strlen(routes))
+	{
+		return add_configured_routes(builder, routes);
+	}
+	return add_routes(builder, child_sa);
+}
